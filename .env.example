# CourtVision AI / AthletaTrack Environment Configuration
# Copy this file to .env for local environment overrides

# Device selection: 'mps' (Apple Silicon), 'cuda' (NVIDIA GPU), or 'cpu' (Auto-detected if unset)
# COURTVISION_DEVICE=mps

# Default inference image size
COURTVISION_IMGSZ=640

# Default model weights path
COURTVISION_WEIGHTS=weights/best.pt

# Default homography matrix path
COURTVISION_HOMOGRAPHY=data/homography_matrix.json
